# ==============================================================
# ZAROORATSETU - ENVIRONMENT CONFIGURATION (.env.example)
# HackFest 3.0 · Open Innovation / Civic Tech · Pilot: REC Banda
# ==============================================================

# -----------------
# Server Environment
# -----------------
PORT=5000
NODE_ENV=development

# Gemini AI API Key (REQUIRED ONLY FOR LIVE GEMINI CALLS)
# When set to 'mock_gemini_key' or omitted, the backend automatically uses deterministic rule-based triage.
# Kept securely on backend ONLY — never exposed to client!
GEMINI_API_KEY=mock_gemini_key

# Single-Use Handover Token Secret
QR_HMAC_SECRET=zarooratsetu_rec_banda_secret_2026

# Firebase Admin SDK (Optional / Mock Mode by default)
MOCK_FIREBASE=true
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# -----------------
# Client Environment
# -----------------
# Toggle mock mode (accepts demo OTP 123456 offline without SMS bill)
VITE_MOCK=true
VITE_API_URL=http://localhost:5000/api
VITE_PILOT_AREA="REC Banda and nearby areas"
